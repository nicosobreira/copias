root = true

[*]
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{c,h}]
max_line_length = 80

[CMakeLists.txt]
indent_size = 2
tab_width = 2

[CMakePresets.json]
indent_size = 2
tab_width = 2

[*.nix]
indent_size = 2
tab_width = 2

